# Ngày giờ buổi lễ. Bỏ trống thì dùng giá trị theo key visual (17.11.2026 · 18:00).
# Giá trị được đọc lúc build, đổi giá trị thì phải build / deploy lại.

# Định dạng YYYY-MM-DD, vd. 2026-11-20
EVENT_DATE=

# Định dạng HH:mm (24 giờ), vd. 18:30
EVENT_TIME=

# Domain thật của trang, dùng cho link ảnh chia sẻ (Open Graph), vd. https://domain.example
SITE_URL=

# Địa điểm. Bỏ trống thì dùng địa điểm mặc định.
EVENT_VENUE=
EVENT_ADDRESS=
